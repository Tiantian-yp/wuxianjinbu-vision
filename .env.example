# ============================================================
# wuxianjinbu-vision v0.1.0-hotfix 配置文件模板
# 使用方法: 复制此文件为 .env，然后根据实际情况修改配置
#   cp .env.example .env
# ============================================================

# ---------- 服务配置 ----------
# 监听地址，生产环境建议用 127.0.0.1 配合反向代理
HOST=0.0.0.0
# 监听端口
PORT=5000
# 是否开启调试模式（生产环境必须设为 false）
FLASK_DEBUG=false
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ---------- 安全配置（v0.1.0-hotfix 新增） ----------
# 管理员微信名前缀（用于识别管理员）
ADMIN_WECHAT_NAME=行遇书
# 管理员密码（生产环境必须设置！不设置则管理员功能受限制）
# 请设置一个强密码，例如: ADMIN_PASSWORD=your_secure_password_here_123
ADMIN_PASSWORD=
# Flask 密钥，用于session加密，建议修改为随机字符串
# 可以用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成
SECRET_KEY=change_me_to_a_random_secret_key_please

# ---------- 目录配置 ----------
# 上传文件存储目录（相对于web目录或绝对路径）
UPLOAD_DIR=./web/uploads
# 输出文件存储目录（相对于web目录或绝对路径）
OUTPUT_DIR=./web/outputs

# ---------- 上传限制 ----------
# 最大上传文件大小（MB）
MAX_CONTENT_MB=600
# 允许的文件扩展名（逗号分隔）
ALLOWED_EXTENSIONS=mp4,mov,qt,m4v,3gp,avi,mkv,flv,wmv,webm,mts,m2ts

# ---------- 视频处理配置 ----------
# 推荐最大视频时长（分钟），超过会给出警告
RECOMMENDED_MAX_DURATION_MINUTES=10
# 硬限制最大视频时长（秒），超过直接拒绝
HARD_MAX_DURATION_SECONDS=1800
# 处理超时预算（秒）
BUDGET_SECONDS_FOR_PROCESS=180
# 检测阶段耗时比例
BASE_DETECT_RATIO=0.08
# 切割阶段耗时比例
BASE_CUT_RATIO=0.22

# ---------- 任务队列配置 ----------
# 并发处理 worker 数量（建议设为CPU核心数）
TASK_WORKERS=2

# ---------- 部署脚本配置（用于 deploy_via_scp.sh） ----------
# 部署服务器IP地址
DEPLOY_SERVER=your_server_ip_here
# SSH端口
SSH_PORT=22
# SSH用户名
DEPLOY_USER=root
# 远程部署目录
DEPLOY_REMOTE_DIR=/opt/badminton
# 文件保留天数
RETENTION_DAYS=7
